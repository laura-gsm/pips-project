# ============================================================
# 15. PLATFORM COMPARISONS                                   # NEW
#     (replaces Cronbach's alpha: there are no scale items)
# ============================================================
# Do respondents with different platforms differ in screen time,
# sleep, anxiety (GAD-7) and depression (PHQ-9)?

if (use_platform) {
  
  dfp <- df %>% filter(!is.na(platform))
  
  # ---- 15.1 Platform counts ----
  platform_counts <- dfp %>%
    count(platform, name = "n") %>%
    mutate(percent = 100 * n / sum(n))
  
  write_csv(platform_counts, file.path(output_dir, "platform_counts.csv"))
  print(platform_counts)
  
  # ---- 15.2 Descriptives by platform ----
  platform_descriptives <- dfp %>%
    pivot_longer(all_of(all_vars), names_to = "variable", values_to = "value") %>%
    group_by(platform, variable) %>%
    summarise(
      n = sum(!is.na(value)),
      mean = mean(value, na.rm = TRUE),
      sd = sd(value, na.rm = TRUE),
      median = median(value, na.rm = TRUE),
      .groups = "drop"
    )
  
  write_csv(platform_descriptives,
            file.path(output_dir, "platform_descriptives.csv"))
  
  # ---- 15.3 Boxplots by platform ----
  box_data <- dfp %>%
    pivot_longer(all_of(all_vars), names_to = "variable", values_to = "value") %>%
    mutate(variable = factor(variable, levels = all_vars))
  
  platform_boxplot <- ggplot(
    box_data,
    aes(x = platform, y = value, fill = platform)
  ) +
    geom_boxplot(outlier.alpha = 0.2, alpha = 0.85, na.rm = TRUE) +
    stat_summary(fun = mean, geom = "point", shape = 23, size = 2.5,
                 fill = "white", na.rm = TRUE) +
    facet_wrap(~ variable, scales = "free_y", ncol = 2) +
    scale_fill_viridis_d(option = "plasma", end = 0.9) +
    labs(
      title = "Screen Time, Sleep and Mental Health by Platform",
      subtitle = "Boxes: median and quartiles. White diamonds: means.",
      x = NULL, y = NULL
    ) +
    theme_minimal(base_size = 10) +
    theme(
      legend.position = "none",
      axis.text.x = element_text(angle = 40, hjust = 1)
    )
  
  ggsave(
    file.path(output_dir, "platform_boxplots.png"),
    plot = platform_boxplot,
    width = 12, height = 9, dpi = 300
  )
  
  # ---- 15.4 Do platforms differ? Kruskal-Wallis + pairwise tests ----
  # epsilon_squared is an effect size (about .01 small, .06 medium, .14 large).
  platform_omnibus <- map_dfr(all_vars, function(v) {
    d <- dfp %>% select(value = all_of(v), platform) %>% drop_na()
    kw <- kruskal.test(value ~ platform, data = d)
    tibble(
      variable = v,
      n = nrow(d),
      kruskal_H = unname(kw$statistic),
      df = unname(kw$parameter),
      p_value = kw$p.value,
      epsilon_squared = unname(kw$statistic) / (nrow(d) - 1)
    )
  }) %>%
    mutate(
      p_adjusted = p.adjust(p_value, method = "BH"),
      significant_adjusted = p_adjusted < 0.05
    )
  
  write_csv(platform_omnibus,
            file.path(output_dir, "platform_kruskal_wallis.csv"))
  print(platform_omnibus)
  
  # Pairwise Wilcoxon tests (BH-adjusted within each variable)
  platform_pairwise <- map_dfr(all_vars, function(v) {
    d <- dfp %>% select(value = all_of(v), platform) %>% drop_na()
    pw <- pairwise.wilcox.test(d$value, d$platform,
                               p.adjust.method = "BH", exact = FALSE)
    broom::tidy(pw) %>% mutate(variable = v, .before = 1)
  })
  
  write_csv(platform_pairwise,
            file.path(output_dir, "platform_pairwise_wilcoxon.csv"))
  
  # ---- 15.5 Does the screen time slope differ by platform? ----
  platform_interaction <- map_dfr(outcome_vars, function(y) {
    d <- dfp %>% select(all_of(c(y, social_vars, "platform"))) %>% drop_na()
    base  <- lm(reformulate(c(social_vars, "platform"), y), data = d)
    inter <- lm(reformulate(
      c(social_vars, "platform", paste0(social_vars, ":platform")), y), data = d)
    a <- anova(base, inter)
    tibble(
      outcome = y,
      p_interaction = a$`Pr(>F)`[2],
      r2_without_interaction = summary(base)$r.squared,
      r2_with_interaction = summary(inter)$r.squared
    )
  }) %>%
    mutate(p_interaction_adj = p.adjust(p_interaction, method = "BH"))
  
  write_csv(platform_interaction,
            file.path(output_dir, "platform_interaction_tests.csv"))
  print(platform_interaction)
  
  line_data <- dfp %>%
    select(platform, all_of(c(social_vars, outcome_vars))) %>%
    pivot_longer(all_of(outcome_vars), names_to = "outcome",
                 values_to = "outcome_value") %>%
    mutate(outcome = factor(outcome, levels = outcome_vars))
  
  platform_line_plot <- ggplot(
    line_data,
    aes(x = .data[[social_vars]], y = outcome_value, colour = platform)
  ) +
    geom_smooth(method = "lm", formula = y ~ x, se = FALSE,
                linewidth = 1, na.rm = TRUE) +
    facet_wrap(~ outcome, scales = "free_y", ncol = 3) +
    scale_colour_viridis_d(option = "plasma", end = 0.9) +
    labs(
      title = "Screen Time and Outcomes, by Platform",
      x = "Daily screen time (hours)", y = "Outcome", colour = "Platform"
    ) +
    theme_minimal(base_size = 10)
  
  ggsave(
    file.path(output_dir, "platform_fitted_lines.png"),
    plot = platform_line_plot,
    width = 12, height = 4.5, dpi = 300
  )
  
} else {
  
  message("Platform comparisons skipped: fewer than 2 usable platforms.")
}


