)


# ------------------------------------------------------------
# 6. SERVER
# ------------------------------------------------------------

server <- function(input, output, session) {

  preds <- reactive({
    req(input$platforms, input$hours)
    predict_all(input$platforms, input$hours)
  })

  output$warning_none <- renderUI({
    if (length(input$platforms) == 0) {
      div(class = "disclaimer", "Please tick at least one platform.")
    }
  })

  output$card_sleep <- renderUI({
    p <- preds()
    outcome_card("Sleep_Duration_Hours", p[p$outcome == "Sleep_Duration_Hours", ])
  })
  output$card_gad <- renderUI({
    p <- preds()
    outcome_card("GAD_7_Score", p[p$outcome == "GAD_7_Score", ])
  })
  output$card_phq <- renderUI({
    p <- preds()
    outcome_card("PHQ_9_Score", p[p$outcome == "PHQ_9_Score", ])
  })

  output$platform_table <- renderTable({
    p <- preds()
    p %>%
      mutate(
        Outcome = vapply(outcome, function(o) outcome_info[[o]]$label, character(1)),
        Prediction = sprintf("%.1f", fit),
        `95% CI for the average person` = sprintf("%.1f \u2013 %.1f", ci_low, ci_high),
        `95% range for an individual` = sprintf("%.1f \u2013 %.1f", pred_low, pred_high)
      ) %>%
      select(Platform = platform, Outcome, Prediction,
             `95% CI for the average person`, `95% range for an individual`) %>%
      arrange(Platform, match(Outcome, vapply(outcome_vars,
                                              function(o) outcome_info[[o]]$label,
                                              character(1))))
  }, striped = TRUE, spacing = "s", width = "100%")

  output$curve_plot <- renderPlot({
    req(input$platforms, input$hours)
    grid <- seq(screen_min, screen_max, length.out = 60)

    curve_data <- bind_rows(lapply(input$platforms, function(pl) {
      newdata <- data.frame(Daily_Screen_Time_Hours = grid,
                            platform = factor(pl, levels = levels(df$platform)))
      names(newdata)[1] <- screen_var
      bind_rows(lapply(outcome_vars, function(y) {
        info <- outcome_info[[y]]
        data.frame(
          hours = grid,
          platform = pl,
          outcome = info$label,
          value = clamp(predict(models[[y]], newdata), info$lower, info$upper)
        )
      }))
    }))

    outcome_labels <- vapply(outcome_vars, function(o) outcome_info[[o]]$label,
                             character(1))
    curve_data$outcome <- factor(curve_data$outcome, levels = outcome_labels)

    current <- preds() %>%
      mutate(outcome = factor(
        vapply(outcome, function(o) outcome_info[[o]]$label, character(1)),
        levels = outcome_labels
      ), hours = input$hours)

    ggplot(curve_data, aes(x = hours, y = value, colour = platform)) +
      geom_line(linewidth = 1) +
      geom_vline(xintercept = input$hours, linetype = "dashed", colour = "grey40") +
      geom_point(data = current, aes(y = fit), size = 3.5) +
      facet_wrap(~ outcome, scales = "free_y", ncol = 3) +
      scale_colour_viridis_d(option = "plasma", end = 0.85) +
      labs(x = "Daily screen time (hours)", y = "Predicted value",
           colour = "Platform",
           subtitle = "Dots and dashed line mark your current settings") +
      theme_minimal(base_size = 12) +
      theme(legend.position = "bottom")
  })

  output$fit_table <- renderTable(model_summary_table, striped = TRUE, width = "100%")
  output$coef_table <- renderTable(coef_table, striped = TRUE, spacing = "s",
                                   width = "100%")
}

shinyApp(ui, server)
