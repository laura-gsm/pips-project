        selected = ref_platform
      ),
      sliderInput(
        "hours", "Daily screen time (hours)",
        min = screen_min, max = screen_max,
        value = min(max(screen_mean, screen_min), screen_max),
        step = 0.1
      ),
      helpText(paste0(
        "The slider covers the screen-time range seen in the data (",
        screen_min, "\u2013", screen_max, " hours)."
      )),
      div(class = "disclaimer",
          strong("Please note: "),
          "This is a statistical model of associations in survey data. It does not show ",
          "that screen time or a platform causes these outcomes, and it is not a ",
