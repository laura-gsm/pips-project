library(shiny)
library(ggplot2)

# ------------------------------------------------------------
# CONFIGURATION: CHECK AGAINST YOUR CODEBOOK
# ------------------------------------------------------------
data_url <- "https://raw.githubusercontent.com/laura-gsm/pips-project/refs/heads/main/hbsc_data.csv"

# Coding of the emcsocmed items in the raw data (default 1 = yes, 2 = no).
# If the items are coded 0/1, set no_code <- 0.
yes_code <- 1
no_code  <- 2

# ASSUMPTIONS about screen time (NOT estimated from the data):
#   0 hours            -> lowest observed symptom score
#   typical_hours      -> average symptom score
#   max_hours or more  -> highest observed symptom score
typical_hours <- 3
max_hours     <- 12

# Associations weaker than this (|Spearman rho|) are treated as "no clear link".
min_rho <- 0.10

# Cut-offs in standard deviations (SD) of the outcome, measured as the
# predicted difference from the average respondent (positive = less favourable).
#   below average  : < -0.10 SD
#   average        : -0.10 to 0.20 SD
#   above average  :  0.20 to 0.50 SD   (0.2 = small, 0.5 = medium effect)
#   very above     : >= 0.50 SD
effect_cutoffs <- c(-0.10, 0.20, 0.50)

# Outcome information. higher_is_worse and the descriptions are ASSUMED
# from the variable names. Verify them in the codebook.
outcome_info <- list(
  feellow = list(
    label = "Feeling low",
    description = "How often you feel low or down.",
    scale_note = "Higher values = more frequent (assumed).",
    higher_is_worse = TRUE
  ),
  nervous = list(
    label = "Feeling nervous",
    description = "How often you feel nervous.",
    scale_note = "Higher values = more frequent (assumed).",
    higher_is_worse = TRUE
  ),
  sleepdificulty = list(
    label = "Difficulty sleeping",
    description = "How often you have trouble getting to sleep.",
    scale_note = "Higher values = more frequent (assumed).",
    higher_is_worse = TRUE
  ),
  physact60 = list(
    label = "Physical activity",
    description = "Days per week with at least 60 minutes of physical activity.",
    scale_note = "Higher values = more active (assumed). Here, LOWER is less favourable.",
    higher_is_worse = FALSE
  )
)

