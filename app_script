library(shiny)
library(ggplot2)

# ------------------------------------------------------------
# CONFIGURATION: CHECK AGAINST YOUR CODEBOOK
# ------------------------------------------------------------
data_url <- "https://raw.githubusercontent.com/laura-gsm/pips-project/refs/heads/main/hbsc_data.csv"

# NEW: coding of the emcsocmed items in the raw data.
# Default assumes 1 = yes and 2 = no. If the items are coded 0/1, set no_code <- 0.
yes_code <- 1
no_code  <- 2

# ASSUMPTION (not estimated from the data): screen time is linked to the
# combined emcsocmed2-9 score by a straight line. 0 hours = lowest observed
# score; max_hours or more = highest observed score.
max_hours <- 12

# Outcome information. higher_is_worse and the descriptions are ASSUMED
# from the variable names. Verify them in the codebook.
outcome_info <- list(
  feellow = list(
    label = "Feeling low",
    description = "How often you feel low or down.",
    scale_note = "Higher values = more frequent (assumed).",
    higher_is_worse = TRUE
  ),
  nervous = list(
    label = "Feeling nervous",
    description = "How often you feel nervous.",
    scale_note = "Higher values = more frequent (assumed).",
    higher_is_worse = TRUE
  ),
  sleepdificulty = list(
    label = "Difficulty sleeping",
    description = "How often you have trouble getting to sleep.",
    scale_note = "Higher values = more frequent (assumed).",
    higher_is_worse = TRUE
  ),
  physact60 = list(
    label = "Physical activity",
    description = "Days per week with at least 60 minutes of physical activity.",
    scale_note = "Higher values = more active (assumed). Here, LOWER is less favourable.",
    higher_is_worse = FALSE
  )
)

# Cut-offs for the position bar (percentile of "less favourable" outcome)
# 0-25 = below average, 25-75 = average, 75-90 = above, 90-100 = very above
cutoffs <- c(25, 75, 90)

status_colors <- c(
  below      = "#2E9E6B",
  average    = "#E7B93C",
  above      = "#E8833A",
  very_above = "#C8423B",
  neutral    = "#7F8C9A"
)

# ------------------------------------------------------------
# DATA SET-UP (same logic as the analysis script)
# ------------------------------------------------------------
df <- read.csv(data_url, row.names = NULL)

all_items       <- paste0("emcsocmed", 1:9)
addiction_items <- paste0("emcsocmed", 2:9)
social_vars_all <- c("emcsocmed1", "socmed_addication_sympt")
outcome_vars    <- names(outcome_info)

missing_vars <- setdiff(c(all_items, outcome_vars), names(df))
if (length(missing_vars) > 0) {
  stop("Variables not found in the data: ",
       paste(missing_vars, collapse = ", "))
}

# ---- FIXED: recode items to 1 = yes, 0 = no BEFORE summing ----
item_values <- unlist(df[all_items])
message("Item values found in the data: ",
        paste(sort(unique(na.omit(item_values))), collapse = ", "))

if (!any(item_values %in% c(yes_code, no_code))) {
  stop("None of the emcsocmed values match yes_code/no_code. ",
       "Check the coding in the codebook and update the configuration.")
}

n_unrecognised <- sum(!is.na(item_values) & !(item_values %in% c(yes_code, no_code)))
if (n_unrecognised > 0) {
  message(n_unrecognised, " item responses with other values (e.g. missing codes) ",
          "were set to NA.")
}

df[all_items] <- lapply(df[all_items], function(x) {
  ifelse(x == yes_code, 1, ifelse(x == no_code, 0, NA))
})

# Combine emcsocmed2-9 into one sum score:
# number of "yes" answers (0-8), higher = more symptoms.
# NA if any of the 8 items is missing.
df$socmed_addication_sympt <- rowSums(df[addiction_items])

score_range <- range(df$socmed_addication_sympt, na.rm = TRUE)

hours_to_score <- function(hours) {
  score_range[1] + pmin(hours / max_hours, 1) * diff(score_range)
}

# ------------------------------------------------------------
# ASSOCIATIONS FROM THE ANALYSIS SCRIPT
# ------------------------------------------------------------
# Spearman correlations, BH correction across all 8 tests (section 8).
spearman_one <- function(x_var, y_var) {
  d <- na.omit(df[, c(x_var, y_var)])
  test <- cor.test(d[[x_var]], d[[y_var]], method = "spearman", exact = FALSE)
  data.frame(social_variable = x_var, outcome = y_var, n = nrow(d),
             rho = unname(test$estimate), p_value = test$p.value)
}

grid <- expand.grid(x = social_vars_all, y = outcome_vars,
                    stringsAsFactors = FALSE)
cor_results <- do.call(rbind, Map(spearman_one, grid$x, grid$y))
rownames(cor_results) <- NULL
cor_results$p_adjusted <- p.adjust(cor_results$p_value, method = "BH")

# Simple regression per outcome: outcome ~ combined score
models <- lapply(setNames(outcome_vars, outcome_vars), function(o) {
  model_data <- na.omit(df[, c(o, "socmed_addication_sympt")])
  lm(reformulate("socmed_addication_sympt", response = o), data = model_data)
})

# ---- NEW: sanity check printed in the R console at startup ----
for (o in outcome_vars) {
  direction <- if (outcome_info[[o]]$higher_is_worse) 1 else -1
  rho <- cor_results$rho[
    cor_results$social_variable == "socmed_addication_sympt" &
      cor_results$outcome == o]
  message(sprintf(
    "CHECK %-15s rho = %5.2f -> more symptoms go with %s values of this outcome",
    o, rho, if (direction * rho > 0) "WORSE" else "BETTER"))
}

# ------------------------------------------------------------
# MESSAGES
# ------------------------------------------------------------
status_title <- c(
  below      = "Nice!",
  average    = "That's okay, I guess.",
  above      = "Maybe reduce?",
  very_above = "Please seek help.",
  neutral    = "No clear link"
)

status_text <- function(status, label, hours) {
  switch(
    status,
    below = paste0(
      "At ", hours, " h/day, your predicted result for \"", label,
      "\" is better than most respondents'. Keep doing what works for you."
    ),
    average = paste0(
      "At ", hours, " h/day, your predicted result for \"", label,
      "\" is about average. Nothing alarming, but small changes can still help."
    ),
    above = paste0(
      "At ", hours, " h/day, your predicted result for \"", label,
      "\" is less favourable than average. If you want to improve it, ",
      "you could try cutting back your screen time a little."
    ),
    very_above = paste0(
      "At ", hours, " h/day, your predicted result for \"", label,
      "\" is much less favourable than most respondents'. This is not a ",
      "diagnosis, but if you are struggling, please talk to someone you ",
      "trust or to a health professional (for example a GP or school counsellor)."
    ),
    neutral = paste0(
      "In this dataset, the combined social media score is not significantly ",
      "associated with \"", label, "\" after correction for multiple testing. ",
      "So we cannot say how your screen time relates to it."
    )
  )
}

