# ------------------------------------------------------------
# SERVER
# ------------------------------------------------------------
server <- function(input, output, session) {
  
  res <- reactive({
    o <- input$outcome
    info <- outcome_info[[o]]
    st <- outcome_stats[[o]]
    model <- models[[o]]
    score <- hours_to_score(input$hours)
    
    pred <- predict(model,
                    newdata = data.frame(socmed_addication_sympt = score),
                    interval = "prediction", level = 0.95)
    fit_raw <- pred[1, "fit"]
    mean_fit <- unname(predict(
      model, newdata = data.frame(socmed_addication_sympt = mean_score)))
    
    rng <- range(df[[o]], na.rm = TRUE)
    clamp <- function(x) pmin(pmax(x, rng[1]), rng[2])
    
    # Effect size: predicted difference from the average respondent, in SD.
    # Positive = less favourable.
    direction <- if (info$higher_is_worse) 1 else -1
    diff_pts <- fit_raw - mean_fit
    effect_sd <- direction * diff_pts / st$sd
    
    cor_row <- cor_results[
      cor_results$social_variable == "socmed_addication_sympt" &
        cor_results$outcome == o, ]
    meaningful <- !is.na(cor_row$p_adjusted) &&
      cor_row$p_adjusted < 0.05 &&
      abs(cor_row$rho) >= min_rho
    
    status <- if (!meaningful) {
      "neutral"
    } else if (effect_sd < effect_cutoffs[1]) {
      "below"
    } else if (effect_sd < effect_cutoffs[2]) {
      "average"
    } else if (effect_sd < effect_cutoffs[3]) {
      "above"
    } else {
      "very_above"
    }
    
    list(
      o = o, info = info, score = score, direction = direction,
      fit_raw = fit_raw, fit = clamp(fit_raw),
      lwr = clamp(pred[1, "lwr"]), upr = clamp(pred[1, "upr"]),
      mean_fit = mean_fit, mean_outcome = st$mean, sd_outcome = st$sd,
      diff_pts = diff_pts, effect_sd = effect_sd,
      slope = unname(coef(model)[2]),
      r2 = summary(model)$r.squared,
      rho = cor_row$rho, p_adj = cor_row$p_adjusted, n = cor_row$n,
      status = status, color = status_colors[[status]]
    )
  })
  
  diff_sentence <- function(r) {
    if (r$status == "neutral") return(NULL)
    paste0(
      "Compared with the average respondent, you are predicted to score ",
      sprintf("%.2f", abs(r$diff_pts)), " points ",
      if (r$diff_pts >= 0) "higher" else "lower",
      " on this scale (", sprintf("%.2f", abs(r$effect_sd)), " SD ",
      if (r$effect_sd >= 0) "less" else "more", " favourable)."
    )
  }
  
  # ---- Outcome card ----------------------------------------
  output$outcome_card <- renderUI({
    r <- res()
    div(
      class = "card",
      h4(r$info$label),
      p(r$info$description),
      p(class = "small-note", r$info$scale_note)
    )
  })
  
  # ---- Status card -----------------------------------------
  output$status_card <- renderUI({
    r <- res()
    div(
      class = "card status-card",
      style = paste0("border-left-color:", r$color, ";"),
      div(class = "status-title", style = paste0("color:", r$color, ";"),
          status_title[[r$status]]),
      p(status_text(r$status, r$info$label, input$hours)),
      if (r$status != "neutral") p(diff_sentence(r)),
      p(strong("Predicted value: "), round(r$fit, 1),
        span(class = "small-note",
             paste0("  (dataset average: ", round(r$mean_outcome, 1), ")")))
    )
  })
  
  # ---- Position bar ----------------------------------------
  output$position_plot <- renderPlot({
    r <- res()
    lim <- c(-0.5, 1.0)
    x_pos <- pmin(pmax(r$effect_sd, lim[1]), lim[2])
    if (r$status == "neutral") x_pos <- 0
    
    zones <- data.frame(
      xmin = c(lim[1], effect_cutoffs),
      xmax = c(effect_cutoffs, lim[2]),
      label = c("Below\naverage", "Average", "Above\naverage", "Very above\naverage"),
      fill = unname(status_colors[c("below", "average", "above", "very_above")])
    )
    
    ggplot() +
      geom_rect(data = zones,
                aes(xmin = xmin, xmax = xmax, ymin = 0, ymax = 1, fill = fill),
                colour = col_card, linewidth = 2) +
      geom_text(data = zones,
                aes(x = (xmin + xmax) / 2, y = 0.5, label = label),
                colour = "#1a1530", fontface = "bold", size = 3.6,
                lineheight = 0.9) +
      scale_fill_identity() +
      annotate("segment", x = x_pos, xend = x_pos, y = 0, yend = 1.15,
               colour = col_text, linewidth = 1.3) +
      annotate("point", x = x_pos, y = 1.2, shape = 25, size = 6,
               fill = col_text, colour = col_text) +
      annotate("label", x = x_pos, y = 1.6, label = "You",
               fill = col_text, colour = col_bg, fontface = "bold",
               label.size = 0) +
      annotate("text", x = effect_cutoffs,  y = -0.14,
               label = sprintf("%+.1f SD", effect_cutoffs),
               colour = col_muted, size = 3.2) +
      annotate("text", x = lim[1], y = -0.42, label = "Better than the average respondent",
               hjust = 0, colour = col_muted, size = 3.5) +
      annotate("text", x = lim[2], y = -0.42, label = "Less favourable than average",
               hjust = 1, colour = col_muted, size = 3.5) +
      scale_x_continuous(limits = lim, expand = c(0.005, 0)) +
      coord_cartesian(ylim = c(-0.55, 1.85), clip = "off") +
      labs(title = "Where you stand compared with the average respondent") +
      theme_void(base_size = 13) +
      theme(
        plot.title = element_text(face = "bold", size = 15, colour = col_text),
        plot.background = element_rect(fill = col_card, colour = NA),
        plot.margin = margin(5, 15, 5, 15)
      )
  })
  
  # ---- Screen time effect plot -----------------------------
  output$effect_plot <- renderPlot({
    r <- res()
    model <- models[[r$o]]
    hrs <- seq(0, max_hours, by = 0.1)
    curve <- data.frame(
      hours = hrs,
      y = predict(model, newdata = data.frame(
        socmed_addication_sympt = hours_to_score(hrs)))
    )
    
    y_rng <- range(c(curve$y, r$mean_fit, r$fit_raw))
    pad <- max(diff(y_rng) * 0.3, 0.05)
    y_lim <- y_rng + c(-pad, pad)
    
    p <- ggplot()
    
    if (r$status != "neutral") {
      edges_w <- c(-Inf, effect_cutoffs, Inf)
      edges_y <- r$mean_fit + r$direction * edges_w * r$sd_outcome
      bands <- data.frame(
        ymin = pmin(edges_y[1:4], edges_y[2:5]),
        ymax = pmax(edges_y[1:4], edges_y[2:5]),
        fill = unname(status_colors[c("below", "average", "above", "very_above")])
      )
      p <- p + geom_rect(data = bands,
                         aes(xmin = -Inf, xmax = Inf, ymin = ymin, ymax = ymax,
                             fill = fill),
                         alpha = 0.20) +
        scale_fill_identity()
    }
    
    p +
      geom_hline(yintercept = r$mean_fit, linetype = "dashed",
                 colour = col_muted, linewidth = 0.7) +
      annotate("text", x = max_hours, y = r$mean_fit, label = "Average respondent",
               hjust = 1, vjust = -0.6, colour = col_muted, size = 3.6) +
      geom_line(data = curve, aes(x = hours, y = y),
                colour = col_pink, linewidth = 1.8) +
      annotate("point", x = input$hours, y = r$fit_raw, shape = 21, size = 7,
               fill = r$color, colour = "white", stroke = 1.8) +
      annotate("label", x = input$hours, y = r$fit_raw, label = "You",
               fill = r$color, colour = "#1a1530", fontface = "bold",
               vjust = -1, label.size = 0) +
      coord_cartesian(ylim = y_lim, expand = FALSE) +
      scale_x_continuous(breaks = seq(0, max_hours, by = 2)) +
      labs(
        title = paste0("Predicted ", tolower(r$info$label), " by screen time"),
        subtitle = paste0(r$info$scale_note,
                          if (r$status != "neutral")
                            "  Coloured zones: below / average / above / very above average."
                          else "  No meaningful association, so no zones are shown."),
        x = "Daily screen time (hours)",
        y = r$info$label
      ) +
      theme_app()
  })
  
  # ---- Association plot ------------------------------------
  output$assoc_plot <- renderPlot({
    r <- res()
    plot_data <- na.omit(data.frame(
      x = df$socmed_addication_sympt,
      y = df[[r$o]]
    ))
    set.seed(1)
    if (nrow(plot_data) > 3000) {
      plot_data <- plot_data[sample(nrow(plot_data), 3000), ]
    }
    means <- score_means[[r$o]]
    
    ggplot(plot_data, aes(x = x, y = y)) +
      geom_jitter(width = 0.2, height = 0.2, alpha = 0.14, size = 1,
                  colour = "#cdbfff") +
      geom_smooth(method = "lm", formula = y ~ x, colour = col_pink,
                  fill = col_pink, alpha = 0.2, linewidth = 1.4) +
      geom_line(data = means, aes(x = x, y = y), colour = col_orange,
                linewidth = 1) +
      geom_point(data = means, aes(x = x, y = y), colour = col_orange, size = 2.5) +
      annotate("point", x = r$score, y = r$fit_raw, shape = 21, size = 7,
               fill = r$color, colour = "white", stroke = 1.8) +
      annotate("label", x = r$score, y = r$fit_raw, label = "You",
               fill = r$color, colour = "#1a1530", fontface = "bold",
               vjust = -1, label.size = 0) +
      labs(
        title = paste0(r$info$label, " by social media symptom score"),
        subtitle = paste0("Pink: linear fit. Orange: average per score. ",
                          "Spearman rho = ", round(r$rho, 2)),
        x = "Social media addiction symptoms (number of 'yes' on emcsocmed2-9)",
        y = r$info$label
      ) +
      theme_app()
  })
  
  # ---- Distribution plot -----------------------------------
  output$dist_plot <- renderPlot({
    r <- res()
    d <- na.omit(data.frame(y = df[[r$o]]))
    
    ggplot(d, aes(x = y)) +
      geom_histogram(bins = min(30, length(unique(d$y))),
                     fill = "#4b3f7a", colour = col_card) +
      geom_vline(xintercept = r$mean_outcome, linetype = "dashed",
                 colour = col_green, linewidth = 1) +
      geom_vline(xintercept = r$fit_raw, colour = r$color, linewidth = 1.8) +
      annotate("label", x = r$fit_raw, y = Inf, label = "Your prediction",
               fill = r$color, colour = "#1a1530", fontface = "bold",
               vjust = 1.4, label.size = 0) +
      annotate("text", x = r$mean_outcome, y = Inf, label = "Average",
               colour = col_green, vjust = 3.6, hjust = -0.15, size = 3.8) +
      labs(
        title = paste0("How respondents score on: ", r$info$label),
        subtitle = r$info$scale_note,
        x = r$info$label, y = "Number of respondents"
      ) +
      theme_app()
  })
  
  # ---- Details ---------------------------------------------
  output$details_card <- renderUI({
    r <- res()
    p_text <- if (r$p_adj < 0.001) "< .001" else paste("=", round(r$p_adj, 3))
    div(
      class = "card",
      tags$details(
        tags$summary("Statistical details"),
        tags$ul(
          tags$li("Screen time entered: ", input$hours, " h/day, corresponding ",
                  "to an assumed symptom score of ", round(r$score, 1),
                  " (average ", round(mean_score, 1), ", observed range ",
                  score_range[1], " to ", score_range[2], ")."),
          tags$li("Spearman rho = ", round(r$rho, 3), ", BH-adjusted p ", p_text,
                  ", n = ", format(r$n, big.mark = ","), "."),
          tags$li("Per extra symptom: ", round(r$slope, 3),
                  " on the outcome scale (R-squared = ", round(r$r2, 3), ")."),
          tags$li("Predicted difference from the average respondent: ",
                  sprintf("%+.2f", r$diff_pts), " points = ",
                  sprintf("%+.2f", r$direction * r$diff_pts / r$sd_outcome),
                  " SD (positive = less favourable)."),
          tags$li("Cut-offs (SD): ", paste(effect_cutoffs, collapse = ", "),
                  ". Minimum |rho| for interpretation: ", min_rho, "."),
          tags$li("95% prediction interval: ", round(r$lwr, 1), " to ",
                  round(r$upr, 1), ".")
        ),
        p(class = "small-note",
          "Associations do not demonstrate causation, and this is not a ",
          "diagnosis. The link between screen time and symptoms is assumed. ",
          "Individual outcomes vary widely.")
      )
    )
  })
  
  # ---- Pop-up window ---------------------------------------
  observeEvent(input$show, {
    r <- res()
    showModal(modalDialog(
      title = tags$span(
        style = paste0("color:", r$color, "; font-weight:800; font-size:28px;"),
        status_title[[r$status]]
      ),
      p(strong(r$info$label), " at ", input$hours, " h/day"),
      p(status_text(r$status, r$info$label, input$hours)),
      if (r$status != "neutral") p(diff_sentence(r)),
      p(class = "small-note",
        "Based on an association in survey data. Not a diagnosis."),
      easyClose = TRUE,
      footer = modalButton("Close"),
      size = "m"
    ))
  })
}

shinyApp(ui, server)
