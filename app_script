# USER INTERFACE
# ------------------------------------------------------------
ui <- fluidPage(
  tags$head(tags$style(HTML(css))),
  
  div(class = "app-header",
      h2("Screen time & wellbeing"),
      p("See how your daily screen time relates to a health outcome, ",
